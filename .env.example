PORT=8080
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
RATE_LIMIT_IP_REQUESTS_PER_SECOND=10
RATE_LIMIT_TOKEN_REQUESTS_PER_SECOND=100
# Optional per-token overrides, in the format token:requests-per-second separated by commas.
RATE_LIMIT_TOKEN_OVERRIDES=premium-token:200,partner-token:500
RATE_LIMIT_WINDOW=1s
RATE_LIMIT_BLOCK_DURATION=5m
